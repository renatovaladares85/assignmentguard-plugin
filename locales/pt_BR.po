msgstr "Estado final"

msgid "Replace group"
msgstr "Substituir grupo"

msgid "Allow multiple groups"
msgstr "Permitir múltiplos grupos"

msgid "Unknown"
msgstr "Desconhecido"

msgid "Coupled actors"
msgstr "Atores acoplados"

msgid "Not installed"
msgstr "Não instalado"

msgid "Inactive"
msgstr "Inativo"

msgid "Unsupported"
msgstr "Não suportado"

msgid "Not authorized"
msgstr "Não autorizado"

msgid "Blocked"
msgstr "Bloqueado"

msgid "Ready"
msgstr "Pronto"

msgid "Not available"
msgstr "Não disponível"
