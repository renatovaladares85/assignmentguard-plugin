{
  "name": "glpi-plugin/assignmentguard",
  "description": "Preventive group-assignment compatibility guard for GLPI 10.",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.13",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "GlpiPlugin\\Assignmentguard\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "php tests/unit.php",
    "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "stan": "phpstan analyse --no-progress --memory-limit=512M"
  }
}
